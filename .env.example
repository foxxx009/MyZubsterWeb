# API 基础地址（后端 Gateway）
VITE_API_BASE=http://localhost:8080

# WebSocket 地址（实时推送）
VITE_WS_URL=ws://localhost:8080/ws

# 地图默认中心（城市中心经纬度）
VITE_MAP_CENTER=39.9042,116.4074

# 地图默认缩放级别
VITE_MAP_ZOOM=12

# 瓦片图源 URL
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# 轮询间隔（毫秒）
VITE_POLL_INTERVAL=15000